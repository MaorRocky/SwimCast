{
  "name": "swimcast",
  "version": "1.0.1",
  "description": "Download your podcasts as MP3 files for swim headphones",
  "main": "src/main/main.js",
  "productName": "SwimCast",
  "author": "Maor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.swimcast.app",
    "productName": "SwimCast",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "zip",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    }
  }
}
